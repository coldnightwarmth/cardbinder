{
  "name": "cards-art-wallet-auth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:browser": "esbuild frontend/wallet-auth-entry.js --bundle --format=esm --platform=browser --target=es2020 --outfile=../wallet-auth.js",
    "build:index": "node scripts/build-supported-card-index.mjs",
    "build:pages": "npm run build:index && node scripts/build-pages.mjs",
    "build:worker": "npm run build:index && wrangler deploy --dry-run --outdir=dist --config wrangler-worker.jsonc",
    "build": "npm run build:browser && npm run build:worker && npm run build:pages",
    "check": "node --check src/auth.js && node --check src/index.js && node --check frontend/wallet-auth-entry.js",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy:worker": "wrangler deploy --config wrangler-worker.jsonc",
    "deploy:pages": "npm run build:pages && wrangler pages deploy",
    "dev": "wrangler dev --local --config wrangler-worker.jsonc --var ALLOW_LOCALHOST_ORIGINS:true",
    "smoke:local": "node scripts/smoke-local-auth.mjs",
    "test": "node --test test/*.test.mjs",
    "dev:showroom": "wrangler dev --config wrangler-showroom.jsonc --port 8788",
    "deploy:showroom": "node scripts/build-showroom-catalog.mjs && wrangler deploy --config wrangler-showroom.jsonc"
  },
  "dependencies": {
    "@solana/wallet-standard-features": "1.4.0",
    "@solana/wallet-standard-util": "1.1.3",
    "@wallet-standard/app": "1.1.1",
    "bs58": "6.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
